---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Imagem de compartilhamento (caminho público, PNG/JPG: o LinkedIn não aceita WebP); padrão: /og.png. */
  imagem?: string;
  tipo?: 'website' | 'article';
}

const { title, description, imagem = '/og.png', tipo = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imagemAbsoluta = new URL(imagem, Astro.site);
---

<!doctype html>
<html lang="pt-BR" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#09090b" />
    <meta name="author" content="João Pedro Teixeira" />

    <meta property="og:type" content={tipo} />
    <meta property="og:site_name" content="João Pedro Teixeira" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imagemAbsoluta} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagemAbsoluta} />
    <script is:inline>
      // Com JS, os elementos animados começam escondidos (ver global.css). Se o GSAP
      // não carregar em 3s, removemos a classe para nada ficar invisível.
      document.documentElement.classList.replace('no-js', 'js');
      setTimeout(() => {
        if (!window.__animReady) document.documentElement.classList.remove('js');
      }, 3000);
    </script>
  </head>
  <body>
    <div id="constellation" class="constellation" aria-hidden="true"></div>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      import { initAnimations } from '../scripts/animations';
      import { initTypewriter } from '../scripts/typewriter';
      import { initInteractions } from '../scripts/interactions';
      import { initSmoothScroll } from '../scripts/smoothScroll';
      initAnimations();
      initTypewriter();
      initInteractions();
      initSmoothScroll();

      // O fundo é decorativo: carrega depois da página pronta e falhas são ignoradas.
      const iniciarFundo = () => {
        const el = document.getElementById('constellation');
        if (el) import('../scripts/constellation').then((m) => m.initConstellation(el)).catch(() => {});
      };
      const agendar = () =>
        'requestIdleCallback' in window
          ? requestIdleCallback(iniciarFundo, { timeout: 2000 })
          : setTimeout(iniciarFundo, 1500);
      if (document.readyState === 'complete') agendar();
      else addEventListener('load', agendar, { once: true });
    </script>
  </body>
</html>
