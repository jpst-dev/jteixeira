---
interface Props {
  numero: string;
  titulo: string;
  linha1: string;
  linha2: string;
}

const { numero, titulo, linha1, linha2 } = Astro.props;
---

<div class="mb-12" data-reveal>
  <p class="font-mono text-sm mb-4">
    <span class="text-subtle">{numero} —</span> <span class="text-text">{titulo}</span>
  </p>
  <h2 class="text-[clamp(2rem,5vw,3.5rem)] font-bold tracking-tight leading-[1.05]">
    <span class="block">{linha1}</span>
    <span class="block text-gradient">{linha2}</span>
  </h2>
</div>
