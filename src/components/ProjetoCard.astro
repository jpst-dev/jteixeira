---
import type { CollectionEntry } from 'astro:content';
import ProjetoThumb from './ProjetoThumb.astro';
import Icon from './ui/Icon.astro';
import { ehDestaque } from '../lib/tags';
import { langDe, projeto as rotaProjeto } from '../i18n/rotas';
import { t } from '../i18n/ui';

interface Props {
  projeto: CollectionEntry<'projetos'>;
}

// Card de "Outros projetos": print, título, resumo curto e as tecnologias centrais.
const { projeto } = Astro.props;
const { titulo, resumo, stack, imagens, tipo } = projeto.data;
const tags = stack.slice(0, 3);
const lang = langDe(Astro.url.pathname);
const tx = t(lang).projetos;
---

<a
  href={rotaProjeto(lang, projeto.id)}
  data-reveal
  data-spotlight
  class="group card flex h-full flex-col rounded-2xl p-3 transition duration-300 hover:border-border-strong"
>
  <ProjetoThumb titulo={titulo} imagem={imagens[0]} />
  <div class="flex flex-1 flex-col p-3 pt-5">
    <p class="font-mono text-xs text-subtle">{tipo}</p>
    <h3 class="mt-1.5 text-xl font-semibold tracking-tight">{titulo}</h3>
    <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-muted">{resumo}</p>
    <ul class="mt-4 flex flex-wrap gap-2 font-mono text-xs">
      {tags.map((tech, i) => (
        <li class:list={['tag', ehDestaque(i) && 'tag-principal']}>{tech}</li>
      ))}
    </ul>
    <p class="mt-auto inline-flex items-center gap-1.5 pt-5 text-sm font-semibold text-text">
      {tx.verCase}
      <Icon name="arrow-up-right" size={16} class="text-accent transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
    </p>
  </div>
</a>
