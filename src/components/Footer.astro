---
import { langDe } from '../i18n/rotas';
import { t } from '../i18n/ui';

const tx = t(langDe(Astro.url.pathname)).rodape;
const year = new Date().getFullYear();
---

<footer class="border-t border-border">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 flex flex-col sm:flex-row gap-2 justify-between text-sm">
    <p class="text-muted">&copy; {year} João Pedro Teixeira</p>
    <p class="font-mono text-xs text-subtle">{tx.feitoCom}</p>
  </div>
</footer>
