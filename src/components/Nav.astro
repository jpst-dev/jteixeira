---
import MobileMenu from './MobileMenu.vue';
import Icon from './ui/Icon.astro';

const links = [
  { href: '#sobre', label: 'Sobre' },
  { href: '#carreira', label: 'Carreira' },
  { href: '#projetos', label: 'Projetos' },
  { href: '#skills', label: 'Skills' },
  { href: '#contato', label: 'Contato' },
];
const cvHref = '/Joao-Pedro-Teixeira-Desenvolvedor-Front-End.pdf';
---

<header
  id="site-header"
  aria-label="Navegação principal"
  class="fixed top-0 inset-x-0 z-50 border-b border-transparent transition-colors duration-300 [&.is-scrolled]:bg-bg/80 [&.is-scrolled]:backdrop-blur [&.is-scrolled]:border-border"
>
  <nav class="max-w-6xl mx-auto flex items-center justify-between gap-4 px-4 sm:px-6 py-4">
    <a href="/#hero" class="group flex items-center gap-2 font-bold text-lg tracking-tight">
      <span class="font-mono text-base text-accent transition-transform group-hover:-rotate-6" aria-hidden="true">&lt;/&gt;</span>
      <span>jteixeira<span class="text-accent">.dev</span></span>
      <span data-nav-path class="hidden lg:inline-block w-20 font-mono text-xs font-normal text-subtle" aria-hidden="true">~/</span>
    </a>

    <ul data-nav-list class="relative hidden md:flex items-center gap-1 rounded-full border border-border bg-surface/80 backdrop-blur px-2 py-1.5 text-sm text-muted">
      <li data-nav-indicator aria-hidden="true" class="nav-indicator"></li>
      {links.map((link) => (
        <li class="relative">
          <a
            href={`/${link.href}`}
            data-nav-link={link.href.slice(1)}
            class="block rounded-full px-3.5 py-1.5 transition-colors hover:text-text aria-[current=true]:text-text"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <a
      href={cvHref}
      download
      aria-label="Baixar CV"
      title="Baixar CV"
      class="hidden md:inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 font-mono text-xs text-subtle hover:text-text hover:bg-surface transition-colors"
    >
      <Icon name="download" size={14} /> cv
    </a>

    <div class="md:hidden">
      <MobileMenu links={links.map((l) => ({ ...l, href: `/${l.href}` }))} cvHref={cvHref} client:media="(max-width: 767px)" />
    </div>
  </nav>
  <span class="nav-neon" aria-hidden="true"></span>
</header>

<script>
  const header = document.getElementById('site-header');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 16);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
  const lista = document.querySelector<HTMLElement>('[data-nav-list]');
  const indicador = document.querySelector<HTMLElement>('[data-nav-indicator]');
  const caminho = document.querySelector<HTMLElement>('[data-nav-path]');

  // Move a pílula verde para baixo do link ativo (ou esconde, no hero).
  const marcar = (id: string | null) => {
    let ativo: HTMLAnchorElement | undefined;
    navLinks.forEach((link) => {
      if (link.dataset.navLink === id) {
        link.setAttribute('aria-current', 'true');
        ativo = link;
      } else link.removeAttribute('aria-current');
    });
    if (caminho) caminho.textContent = `~/${ativo ? id : ''}`;
    if (!indicador || !lista) return;
    if (!ativo) {
      indicador.style.opacity = '0';
      return;
    }
    const base = lista.getBoundingClientRect();
    const r = ativo.getBoundingClientRect();
    indicador.style.opacity = '1';
    indicador.style.width = `${r.width}px`;
    indicador.style.translate = `${r.left - base.left - lista.clientLeft}px 0`;
  };

  const ids = ['hero', ...Array.from(navLinks, (l) => l.dataset.navLink ?? '')];
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) marcar(entry.target.id === 'hero' ? null : entry.target.id);
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  for (const id of ids) {
    const section = document.getElementById(id);
    if (section) observer.observe(section);
  }
  // Recalcula a posição se a pílula mudar de tamanho (fontes carregando, resize).
  if (lista) new ResizeObserver(() => marcar(document.querySelector('[data-nav-link][aria-current]')?.getAttribute('data-nav-link') ?? null)).observe(lista);
</script>

<style>
  .nav-indicator {
    position: absolute;
    top: 0.375rem;
    bottom: 0.375rem;
    left: 0;
    width: 0;
    opacity: 0;
    border-radius: 9999px;
    background: rgba(66, 211, 146, 0.12);
    box-shadow:
      inset 0 0 0 1px rgba(66, 211, 146, 0.35),
      0 0 18px -4px rgba(66, 211, 146, 0.5);
    transition:
      translate 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      width 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.3s;
  }

  /* Brilho neon atravessando a borda de baixo, da esquerda para a direita. */
  .nav-neon {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    overflow: hidden;
    pointer-events: none;
  }
  .nav-neon::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 30%;
    height: 100%;
    background: linear-gradient(90deg, transparent, var(--color-accent), var(--color-accent-2), transparent);
    box-shadow: 0 0 12px 1px rgba(66, 211, 146, 0.6);
    animation: neon 6s linear infinite;
  }
  @keyframes neon {
    from {
      translate: -100% 0;
    }
    to {
      translate: 340% 0;
    }
  }
</style>
