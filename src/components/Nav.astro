---
import MobileMenu from './MobileMenu.vue';
import Icon from './ui/Icon.astro';
import { caminhoAlternativo, cvPdf, home, langDe, secoes } from '../i18n/rotas';
import { t } from '../i18n/ui';

const lang = langDe(Astro.url.pathname);
const tx = t(lang).nav;
const inicio = home(lang);
const chaves = ['sobre', 'carreira', 'projetos', 'skills', 'contato'] as const;
const links = chaves.map((chave) => ({ id: secoes[lang][chave], href: `${inicio}#${secoes[lang][chave]}`, label: tx.links[chave] }));
const cvHref = cvPdf(lang);
const outroIdioma = { href: caminhoAlternativo(Astro.url.pathname), lang: lang === 'pt' ? 'en' : 'pt-BR' };
---

<header
  id="site-header"
  aria-label={tx.aria}
  class="fixed top-0 inset-x-0 z-50 border-b border-transparent transition-colors duration-300 [&.is-scrolled]:bg-bg/80 [&.is-scrolled]:backdrop-blur [&.is-scrolled]:border-border"
>
  <nav class="max-w-6xl mx-auto flex items-center justify-between gap-4 px-4 sm:px-6 py-4">
    <a href={`${inicio}#hero`} class="group flex items-center gap-2 font-bold text-xl tracking-tight">
      <span class="font-mono text-lg text-accent transition-transform group-hover:-rotate-6" aria-hidden="true">&lt;/&gt;</span>
      <span>jteixeira<span class="text-accent">.dev</span></span>
      <span data-nav-path class="hidden lg:inline-block w-24 font-mono text-sm font-normal text-subtle" aria-hidden="true">~/</span>
    </a>

    <ul data-nav-list class="relative hidden md:flex items-center gap-2 lg:gap-4 text-base text-muted">
      <li data-nav-indicator aria-hidden="true" class="nav-indicator"></li>
      {links.map((link) => (
        <li class="relative">
          <a
            href={link.href}
            data-nav-link={link.id}
            class="nav-link block px-2 py-2 transition-colors hover:text-text aria-[current=true]:text-text"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="hidden md:flex items-center gap-1">
      <a
        href={cvHref}
        download
        aria-label={tx.baixarCv}
        title={tx.baixarCv}
        class="inline-flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 font-mono text-sm text-subtle hover:text-text hover:bg-surface transition-colors"
      >
        <Icon name="download" size={16} /> cv
      </a>
      <a
        href={outroIdioma.href}
        hreflang={outroIdioma.lang}
        lang={outroIdioma.lang}
        aria-label={tx.trocarIdiomaAria}
        title={tx.trocarIdiomaAria}
        class="rounded-lg px-2.5 py-1.5 font-mono text-sm text-subtle hover:text-text hover:bg-surface transition-colors"
      >
        {tx.trocarIdioma}
      </a>
    </div>

    <div class="md:hidden">
      <MobileMenu
        links={links}
        cvHref={cvHref}
        idioma={{ ...outroIdioma, label: tx.trocarIdioma, aria: tx.trocarIdiomaAria }}
        textos={{ abrir: tx.abrirMenu, fechar: tx.fecharMenu, menu: tx.menuMobile, baixarCv: tx.baixarCv }}
        client:media="(max-width: 767px)"
      />
    </div>
  </nav>
  <span class="nav-neon" aria-hidden="true"></span>
</header>

<script>
  const header = document.getElementById('site-header');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 16);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
  const lista = document.querySelector<HTMLElement>('[data-nav-list]');
  const indicador = document.querySelector<HTMLElement>('[data-nav-indicator]');
  const caminho = document.querySelector<HTMLElement>('[data-nav-path]');

  // Move a pílula verde para baixo do link ativo (ou esconde, no hero).
  const marcar = (id: string | null) => {
    let ativo: HTMLAnchorElement | undefined;
    navLinks.forEach((link) => {
      if (link.dataset.navLink === id) {
        link.setAttribute('aria-current', 'true');
        ativo = link;
      } else link.removeAttribute('aria-current');
    });
    if (caminho) caminho.textContent = `~/${ativo ? id : ''}`;
    if (!indicador || !lista) return;
    if (!ativo) {
      indicador.style.opacity = '0';
      return;
    }
    const base = lista.getBoundingClientRect();
    const r = ativo.getBoundingClientRect();
    indicador.style.opacity = '1';
    // O sublinhado acompanha só o texto (desconta o padding horizontal do link).
    const padding = parseFloat(getComputedStyle(ativo).paddingLeft);
    indicador.style.width = `${r.width - padding * 2}px`;
    indicador.style.translate = `${r.left - base.left - lista.clientLeft + padding}px 0`;
  };

  const ids = ['hero', ...Array.from(navLinks, (l) => l.dataset.navLink ?? '')];
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) marcar(entry.target.id === 'hero' ? null : entry.target.id);
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  for (const id of ids) {
    const section = document.getElementById(id);
    if (section) observer.observe(section);
  }
  // Recalcula a posição se a lista mudar de tamanho (fontes carregando, resize).
  if (lista) new ResizeObserver(() => marcar(document.querySelector('[data-nav-link][aria-current]')?.getAttribute('data-nav-link') ?? null)).observe(lista);
</script>

<style>
  /* Sublinhado verde do link ativo, deslizando entre os links. */
  .nav-indicator {
    position: absolute;
    bottom: 0.2rem;
    left: 0;
    width: 0;
    height: 2px;
    opacity: 0;
    border-radius: 9999px;
    background: var(--color-accent);
    box-shadow: 0 0 10px rgba(66, 211, 146, 0.7);
    transition:
      translate 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      width 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.3s;
  }

  /* Hover: sublinhado cresce da esquerda para a direita (no ativo, o indicador já cumpre o papel). */
  .nav-link {
    position: relative;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.5rem;
    right: 0.5rem;
    bottom: 0.2rem;
    height: 2px;
    border-radius: 9999px;
    background: var(--color-border-strong);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    transform: scaleX(1);
  }
  .nav-link[aria-current='true']::after {
    display: none;
  }

  /* Brilho neon atravessando a borda de baixo, da esquerda para a direita. */
  .nav-neon {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    overflow: hidden;
    pointer-events: none;
  }
  .nav-neon::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 30%;
    height: 100%;
    background: linear-gradient(90deg, transparent, var(--color-accent), var(--color-accent-2), transparent);
    box-shadow: 0 0 12px 1px rgba(66, 211, 146, 0.6);
    animation: neon 6s linear infinite;
  }
  @keyframes neon {
    from {
      translate: -100% 0;
    }
    to {
      translate: 340% 0;
    }
  }
</style>
