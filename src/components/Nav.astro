---
import MobileMenu from './MobileMenu.vue';
import Icon from './ui/Icon.astro';

const links = [
  { href: '#sobre', label: 'Sobre' },
  { href: '#carreira', label: 'Carreira' },
  { href: '#projetos', label: 'Projetos' },
  { href: '#skills', label: 'Skills' },
  { href: '#contato', label: 'Contato' },
];
const cvHref = '/Joao-Pedro-Teixeira-Desenvolvedor-Front-End.pdf';
---

<header
  id="site-header"
  aria-label="Navegação principal"
  class="fixed top-0 inset-x-0 z-50 border-b border-transparent transition-colors duration-300 [&.is-scrolled]:bg-bg/80 [&.is-scrolled]:backdrop-blur [&.is-scrolled]:border-border"
>
  <nav class="max-w-6xl mx-auto flex items-center justify-between px-4 sm:px-6 py-4">
    <a href="/#hero" class="font-bold text-lg tracking-tight">jpst<span class="text-accent">.</span>dev</a>

    <ul class="hidden md:flex items-center gap-1 rounded-full border border-border bg-surface/80 backdrop-blur px-2 py-1.5 text-sm text-muted">
      {links.map((link) => (
        <li>
          <a
            href={`/${link.href}`}
            data-nav-link={link.href.slice(1)}
            class="block rounded-full px-3.5 py-1.5 transition-colors hover:text-text aria-[current=true]:bg-border aria-[current=true]:text-text"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <a href={cvHref} download class="hidden md:inline-flex items-center gap-2 text-sm text-muted hover:text-text transition-colors">
      <Icon name="download" size={16} /> CV
    </a>

    <div class="md:hidden">
      <MobileMenu links={links.map((l) => ({ ...l, href: `/${l.href}` }))} cvHref={cvHref} client:media="(max-width: 767px)" />
    </div>
  </nav>
</header>

<script>
  const header = document.getElementById('site-header');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 16);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        navLinks.forEach((link) => {
          if (link.dataset.navLink === entry.target.id) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        });
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  navLinks.forEach((link) => {
    const section = document.getElementById(link.dataset.navLink ?? '');
    if (section) observer.observe(section);
  });
</script>
