---
import ContatoForm from './ContatoForm.vue';
import SectionHeading from './ui/SectionHeading.astro';
import Icon from './ui/Icon.astro';
import { langDe, secoes } from '../i18n/rotas';
import { t } from '../i18n/ui';

const lang = langDe(Astro.url.pathname);
const dic = t(lang);
const tx = dic.contato;

const email = 'jteixeira.dev@outlook.com';
const links = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/jpst-dev/', icon: 'linkedin' as const },
  { label: 'GitHub', href: 'https://github.com/jpst-dev', icon: 'github' as const },
];
---

<section id={secoes[lang].contato} class="max-w-6xl mx-auto px-4 sm:px-6 py-24 sm:py-32">
  <SectionHeading numero="05" titulo={tx.titulo} linha1={tx.linha1} linha2={tx.linha2} />
  <div class="grid gap-12 lg:grid-cols-2">
    <div data-reveal>
      <p class="text-lg text-muted max-w-md">{tx.texto}</p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={`mailto:${email}`} class="text-xl sm:text-2xl font-semibold break-all hover:text-accent transition-colors">{email}</a>
        <button
          type="button"
          data-copy={email}
          data-copy-textos={JSON.stringify({ copiar: tx.copiar, copiado: tx.copiado, status: tx.copiadoStatus })}
          data-magnetic
          class="inline-flex items-center gap-1.5 rounded-lg border border-border-strong px-3 py-1.5 text-sm text-muted hover:text-text hover:bg-surface transition-colors"
        >
          <Icon name="copy" size={14} /> <span data-copy-label>{tx.copiar}</span>
        </button>
        <span class="sr-only" aria-live="polite" data-copy-status></span>
      </div>

      <ul class="mt-8 flex gap-3">
        {links.map((link) => (
          <li>
            <a
              data-magnetic
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-xl border border-border bg-surface/85 px-4 py-2.5 text-sm text-muted hover:text-text hover:border-border-strong transition-colors"
            >
              <Icon name={link.icon} size={16} /> {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div data-reveal data-spotlight class="card rounded-2xl p-6 sm:p-8">
      <ContatoForm lang={lang} tx={dic.form} client:visible />
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    const label = button.querySelector('[data-copy-label]');
    const status = button.parentElement?.querySelector('[data-copy-status]');
    const textos = JSON.parse(button.dataset.copyTextos ?? '{}');
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
      } catch {
        return; // sem permissão de clipboard: o link mailto continua disponível
      }
      if (label) label.textContent = textos.copiado;
      if (status) status.textContent = textos.status;
      setTimeout(() => {
        if (label) label.textContent = textos.copiar;
        if (status) status.textContent = '';
      }, 2000);
    });
  });
</script>
