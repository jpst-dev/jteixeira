---
import SectionHeading from './ui/SectionHeading.astro';
import { langDe, secoes } from '../i18n/rotas';
import { t } from '../i18n/ui';

const lang = langDe(Astro.url.pathname);
const tx = t(lang).sobre;
---

<section id={secoes[lang].sobre} class="max-w-6xl mx-auto px-4 sm:px-6 py-24 sm:py-32">
  <SectionHeading numero="01" titulo={tx.titulo} linha1={tx.linha1} linha2={tx.linha2} />
  <div class="grid gap-12 lg:grid-cols-[1.5fr_1fr] items-start">
    <div class="space-y-5 text-lg text-muted leading-relaxed" data-reveal>
      {tx.paragrafos.map((paragrafo) => <p>{paragrafo}</p>)}
      <div class="pt-2">
        <p class="font-mono text-xs text-subtle mb-3">{tx.entregasTitulo}</p>
        <ul class="space-y-2 text-base">
          {tx.entregas.map((item) => (
            <li class="flex gap-3"><span class="text-accent" aria-hidden="true">→</span>{item}</li>
          ))}
        </ul>
      </div>
    </div>
    <ul class="grid gap-4 sm:grid-cols-3 lg:grid-cols-1" data-reveal-group>
      {tx.stats.map((stat) => (
        <li class="rounded-2xl border border-border bg-surface/85 p-5" data-reveal data-spotlight>
          <p class="text-2xl font-bold tracking-tight text-text">{stat.valor}</p>
          <p class="mt-1 font-mono text-xs text-subtle">{stat.legenda}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
