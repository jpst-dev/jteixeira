---
import SectionHeading from './ui/SectionHeading.astro';
import { formatPeriodo } from '../lib/formatPeriodo';
import { duracao } from '../lib/duracao';
import { agruparEmpresas } from '../lib/agruparEmpresas';
import { ehDestaque } from '../lib/tags';
import { formacao, certificacoes } from '../data/perfil';
import { experienciasDoIdioma } from '../data/carreira';
import { langDe, secoes } from '../i18n/rotas';
import { t } from '../i18n/ui';

const lang = langDe(Astro.url.pathname);
const tx = t(lang).carreira;

// Um card por empresa; cargos na mesma empresa viram uma linha do tempo dentro do card.
const empresas = agruparEmpresas(await experienciasDoIdioma(lang));
const hoje = new Date().toISOString().slice(0, 7);
---

<section id={secoes[lang].carreira} class="max-w-6xl mx-auto px-4 sm:px-6 py-24 sm:py-32">
  <SectionHeading numero="02" titulo={tx.titulo} linha1={tx.linha1} linha2={tx.linha2} />
  <ol class="relative border-l border-border ml-1.5 space-y-8" data-reveal-group>
    {empresas.map((empresa) => {
      const { logo, local } = empresa.cargos[0].data;
      const variosCargos = empresa.cargos.length > 1;
      return (
        <li class="relative pl-6 sm:pl-10" data-reveal>
          <span
            class:list={[
              'absolute -left-[7px] top-8 size-3.5 rounded-full border-2 border-bg',
              empresa.fim ? 'bg-border-strong' : 'bg-accent shadow-[0_0_0_4px_rgba(66,211,146,.15),0_0_20px_rgba(66,211,146,.5)]',
            ]}
            aria-hidden="true"
          ></span>
          <article data-spotlight class="card rounded-2xl p-5 sm:p-6 transition-colors hover:border-border-strong">
            <header class="flex items-center gap-4">
              {logo && <img src={logo} alt="" width="44" height="44" loading="lazy" class="logo-empresa" />}
              <div class="min-w-0 flex-1 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-x-4 gap-y-0.5">
                <div class="min-w-0">
                  <h3 class="text-lg font-semibold">{empresa.empresa}</h3>
                  <p class="text-sm text-subtle">{local} · {duracao(empresa.inicio, empresa.fim, hoje, lang)}</p>
                </div>
                {!variosCargos && (
                  <p class="font-mono text-xs text-subtle shrink-0">{formatPeriodo(empresa.inicio, empresa.fim, lang)}</p>
                )}
              </div>
            </header>

            <ol class:list={variosCargos && 'mt-6 ml-1 pl-5 sm:ml-[21px] sm:pl-6 border-l border-border space-y-6'}>
              {empresa.cargos.map(({ data }) => (
                <li class="relative">
                  {variosCargos && (
                    <span
                      class:list={[
                        'absolute -left-[26px] sm:-left-[30px] top-1.5 size-2.5 rounded-full border-2 border-bg',
                        data.fim ? 'bg-border-strong' : 'bg-accent shadow-[0_0_0_3px_rgba(66,211,146,.15),0_0_12px_rgba(66,211,146,.5)]',
                      ]}
                      aria-hidden="true"
                    ></span>
                  )}
                  <div class:list={['flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-x-4', !variosCargos && 'mt-4']}>
                    <h4 class="font-semibold text-text">{data.cargo}</h4>
                    {variosCargos && <p class="font-mono text-xs text-subtle shrink-0">{formatPeriodo(data.inicio, data.fim, lang)}</p>}
                  </div>
                  <ul class="mt-3 space-y-2 text-sm text-muted leading-relaxed list-disc pl-4 marker:text-accent/60">
                    {data.bullets.map((bullet) => <li>{bullet}</li>)}
                  </ul>
                  <ul class="mt-4 flex flex-wrap gap-2">
                    {data.tags.map((tag, i) => <li class:list={['tag', ehDestaque(i) && 'tag-principal']}>{tag}</li>)}
                  </ul>
                </li>
              ))}
            </ol>
          </article>
        </li>
      );
    })}
  </ol>

  <div class="mt-16 grid gap-4 md:grid-cols-[1fr_1.4fr]" data-reveal-group>
    <div class="card rounded-2xl p-6" data-reveal data-spotlight>
      <h3 class="font-semibold mb-4">{tx.formacao}</h3>
      <ul class="space-y-4">
        {formacao[lang].map((item) => (
          <li>
            <p class="text-text">{item.curso}</p>
            <p class="text-sm text-muted">{item.instituicao} · <span class="font-mono text-xs text-subtle">{item.periodo}</span></p>
          </li>
        ))}
      </ul>
    </div>
    <div class="card rounded-2xl p-6" data-reveal data-spotlight>
      <h3 class="font-semibold mb-4">{tx.certificacoes}</h3>
      <ul class="space-y-2 text-sm text-muted list-disc pl-4 marker:text-accent/60">
        {certificacoes[lang].map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>
