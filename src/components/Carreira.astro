---
import { getCollection } from 'astro:content';
import SectionHeading from './ui/SectionHeading.astro';
import { formatPeriodo } from '../lib/formatPeriodo';
import { formacao, certificacoes } from '../data/perfil';
import { langDe, secoes } from '../i18n/rotas';
import { t } from '../i18n/ui';

const lang = langDe(Astro.url.pathname);
const tx = t(lang).carreira;

// Mais recente primeiro; o loader não garante a ordem do JSON.
const experiencias = (await getCollection('carreira'))
  .sort((a, b) => b.data.inicio.localeCompare(a.data.inicio))
  // No EN, cargo/local/bullets vêm do bloco `en` da experiência (obrigatório: nada de PT no /en).
  .map(({ id, data }) => {
    if (lang === 'pt') return { data };
    if (!data.en) throw new Error(`Experiência "${id}" sem bloco "en" em src/content/carreira.json`);
    return { data: { ...data, ...data.en } };
  });
---

<section id={secoes[lang].carreira} class="max-w-6xl mx-auto px-4 sm:px-6 py-24 sm:py-32">
  <SectionHeading numero="02" titulo={tx.titulo} linha1={tx.linha1} linha2={tx.linha2} />
  <ol class="relative border-l border-border ml-1.5 space-y-8" data-reveal-group>
    {experiencias.map(({ data }) => (
      <li class="relative pl-6 sm:pl-10" data-reveal>
        <span
          class:list={[
            'absolute -left-[7px] top-7 size-3.5 rounded-full border-2 border-bg',
            data.fim ? 'bg-border-strong' : 'bg-accent shadow-[0_0_0_4px_rgba(66,211,146,.15),0_0_20px_rgba(66,211,146,.5)]',
          ]}
          aria-hidden="true"
        ></span>
        <article data-spotlight class="rounded-2xl border border-border bg-surface/85 p-5 sm:p-6 transition-colors hover:border-border-strong">
          <header class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
            <h3 class="text-lg font-semibold">{data.empresa}</h3>
            <p class="font-mono text-xs text-subtle">{formatPeriodo(data.inicio, data.fim, lang)}</p>
          </header>
          <p class="mt-1 text-muted">{data.cargo} · <span class="text-subtle">{data.local}</span></p>
          <ul class="mt-4 space-y-2 text-sm text-muted leading-relaxed list-disc pl-4 marker:text-accent/60">
            {data.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
          <ul class="mt-5 flex flex-wrap gap-2 font-mono text-xs">
            {data.tags.map((tag) => (
              <li class="rounded-full border border-border bg-bg px-2.5 py-1 text-muted">{tag}</li>
            ))}
          </ul>
        </article>
      </li>
    ))}
  </ol>

  <div class="mt-16 grid gap-4 md:grid-cols-[1fr_1.4fr]" data-reveal-group>
    <div class="rounded-2xl border border-border bg-surface/85 p-6" data-reveal data-spotlight>
      <h3 class="font-semibold mb-4">{tx.formacao}</h3>
      <ul class="space-y-4">
        {formacao[lang].map((item) => (
          <li>
            <p class="text-text">{item.curso}</p>
            <p class="text-sm text-muted">{item.instituicao} · <span class="font-mono text-xs text-subtle">{item.periodo}</span></p>
          </li>
        ))}
      </ul>
    </div>
    <div class="rounded-2xl border border-border bg-surface/85 p-6" data-reveal data-spotlight>
      <h3 class="font-semibold mb-4">{tx.certificacoes}</h3>
      <ul class="space-y-2 text-sm text-muted list-disc pl-4 marker:text-accent/60">
        {certificacoes[lang].map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>
