---
import SectionHeading from './ui/SectionHeading.astro';
import Icon from './ui/Icon.astro';
import { ehPrincipal } from '../lib/tags';
import { skills } from '../data/perfil';
import { langDe } from '../i18n/rotas';
import { t } from '../i18n/ui';

const lang = langDe(Astro.url.pathname);
const tx = t(lang).skills;
const grupos = skills[lang];
// Ícone de cada grupo, na ordem de perfil.skills: front, back, IA, qualidade.
const icones = ['monitor', 'server', 'sparkles', 'shield-check'] as const;
---

<section id="skills" class="max-w-6xl mx-auto px-4 sm:px-6 py-24 sm:py-32">
  <SectionHeading numero="04" titulo={tx.titulo} linha1={tx.linha1} linha2={tx.linha2} />
  <div class="grid gap-4 md:grid-cols-3" data-reveal-group>
    {grupos.map((grupo, i) => (
      <div
        data-reveal
        data-spotlight
        class:list={[
          'card rounded-2xl p-6 transition-colors hover:border-border-strong',
          i === 0 && 'md:col-span-2',
          i === 3 && 'md:col-span-2',
        ]}
      >
        <h3 class="font-semibold mb-4 flex items-center gap-3">
          <span class="icone-contorno" aria-hidden="true"><Icon name={icones[i]} size={16} /></span>
          {grupo.categoria}
        </h3>
        <ul class="flex flex-wrap gap-2 font-mono text-xs">
          {grupo.itens.map((item) => (
            <li class:list={['tag', ehPrincipal(item) && 'tag-principal']}>{item}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
