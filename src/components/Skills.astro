---
import SectionHeading from './ui/SectionHeading.astro';

const grupos = [
  {
    categoria: 'Front-end',
    itens: ['Vue.js', 'Nuxt', 'React', 'Next.js', 'TypeScript', 'JavaScript', 'Tailwind CSS', 'Pinia', 'Design System'],
  },
  {
    categoria: 'Backend',
    itens: ['C#', '.NET', 'APIs REST', 'Node.js', 'Integração front ↔ API'],
  },
  {
    categoria: 'AI-Assisted Engineering',
    itens: ['Claude Code', 'Cursor', 'Agentes de código', 'Refatoração e testes com IA', 'Revisão humana'],
  },
  {
    categoria: 'Qualidade, testes & entrega',
    itens: ['TDD', 'Jest', 'Vitest', 'Cypress', 'Playwright', 'Code review', 'CI/CD', 'Docker', 'Acessibilidade', 'Performance web'],
  },
];
---

<section id="skills" class="max-w-6xl mx-auto px-4 sm:px-6 py-24 sm:py-32">
  <SectionHeading numero="04" titulo="Skills" linha1="Ferramentas do" linha2="dia a dia." />
  <div class="grid gap-4 md:grid-cols-3" data-reveal-group>
    {grupos.map((grupo, i) => (
      <div
        data-reveal
        class:list={[
          'rounded-2xl border border-border bg-surface/85 p-6 transition-colors hover:border-border-strong',
          i === 0 && 'md:col-span-2',
          i === 3 && 'md:col-span-2',
        ]}
      >
        <h3 class="font-semibold mb-4">{grupo.categoria}</h3>
        <ul class="flex flex-wrap gap-2 font-mono text-xs">
          {grupo.itens.map((item) => (
            <li class="rounded-full border border-border bg-bg px-2.5 py-1 text-muted">{item}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
